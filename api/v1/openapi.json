{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Science Tracker static API",
    "version": "v1",
    "description": "Read-only JSON files: 5356 AI-enabled scientific discoveries and a preview of 13450 of the 470569 vulnerabilities in the global vulnerability dataset (full files on Hugging Face). No authentication. Figures are reported by the linked sources; cite the original source of a claim.",
    "license": {
      "name": "CC BY 4.0",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    }
  },
  "servers": [
    {
      "url": "https://aisciencetracker.org"
    }
  ],
  "externalDocs": {
    "url": "https://aisciencetracker.org/dataset.html"
  },
  "paths": {
    "/api/v1/index.json": {
      "get": {
        "summary": "API index with counts, endpoints and checksums",
        "responses": {
          "200": {
            "description": "JSON document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/latest.json": {
      "get": {
        "summary": "The 100 most recently added discoveries, compact rows",
        "responses": {
          "200": {
            "description": "JSON document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/doi-index.json": {
      "get": {
        "summary": "Lower-case DOI to discovery ID",
        "responses": {
          "200": {
            "description": "JSON document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/fields/{field}.json": {
      "get": {
        "summary": "Compact rows for one field; names are listed under slices in the API index",
        "responses": {
          "200": {
            "description": "JSON document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/years/{year}.json": {
      "get": {
        "summary": "Compact rows for one publication year",
        "responses": {
          "200": {
            "description": "JSON document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/data/discoveries.json": {
      "get": {
        "summary": "Every active discovery",
        "responses": {
          "200": {
            "description": "JSON document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://aisciencetracker.org/schema/discoveries.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/discoveries/{id}.json": {
      "get": {
        "summary": "One discovery",
        "responses": {
          "200": {
            "description": "JSON document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://aisciencetracker.org/schema/discoveries.schema.json#/items"
                }
              }
            }
          },
          "404": {
            "description": "No record with this ID"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Stable record ID",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        ]
      }
    },
    "/data/vulnerabilities-preview.json": {
      "get": {
        "summary": "Preview: known exploited and recent critical vulnerabilities, slim rows",
        "responses": {
          "200": {
            "description": "JSON document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array"
                }
              }
            }
          }
        }
      }
    },
    "/data/vulnerabilities-overview.json": {
      "get": {
        "summary": "Totals, charts, categories and sources of the global vulnerability dataset",
        "responses": {
          "200": {
            "description": "JSON document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/vulnerabilities/{id}.json": {
      "get": {
        "summary": "One preview vulnerability by CVE, GHSA or other ID",
        "responses": {
          "200": {
            "description": "JSON document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "No record with this ID"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Stable record ID",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$"
            }
          }
        ]
      }
    }
  }
}
